# e5-infoscreen 的发布：改这个文件并 push，release workflow 就按下面的字段发布。
# (.github/workflows/release.yml -> tools/make-release.sh)
#   version    版本号，点分，须比设备上已有的新
#   notes_zh   发布说明（中文）
#   notes_en   release notes (English)；留空则用中文
version=1.6.5
notes_zh=完善一键连接诊断：日志服务不可用时仍返回完整报告；包含 USB 重置、设备端检查结论和热点启动失败提示。
notes_en=Keep network diagnostic reports valid when logging services are unavailable; includes USB recovery, on-device check results and hotspot startup errors.
